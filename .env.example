# ── Required (unless using a BYO-LLM provider below) ────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: BYO-LLM for the classifier pipeline ────────────────────────────
# Casky's investigation-plan classifier (casky_pipeline) is model-agnostic.
# Defaults to Anthropic direct using ANTHROPIC_API_KEY above. To use OpenAI,
# Qwen, Kimi, or a local model (Ollama / LM Studio / vLLM) instead, set:
CASKY_MODEL_PROVIDER=anthropic
# CASKY_MODEL_PROVIDER=openai_compatible
# CASKY_MODEL_BASE_URL=https://api.openai.com/v1       # or http://localhost:11434/v1 (Ollama)
# CASKY_MODEL_NAME=gpt-4o-mini                          # provider-specific model id
# CASKY_MODEL_API_KEY=                                  # bearer token, if the endpoint needs one
#
# Note: this is separate from the coding-agent CLI selection (--agent claude|gemini|
# copilot|custom in 'casky run') — this controls which LLM *generates the investigation
# plan itself*, not which agent executes each step.

# ── Optional: Casky platform sync ────────────────────────────────────────────
# CASKY_API_KEY: generate at casky.ai/profile → Runner Token.
# When set, 'casky harness' fetches investigation plans from your dashboard and
# reports findings back. Leave empty for local mode (findings → /var/casky/reports/).
CASKY_API_KEY=
CASKY_APP_URL=https://casky.ai
CASKY_LOCAL_PORT=8765

# Legacy single-run vars — still work for manual: casky run <skill>
CASKY_RUN_ID=
CASKY_TOKEN=

# ── Optional: Gemini CLI ──────────────────────────────────────────────────────
GOOGLE_API_KEY=

# ── Optional: CVE MCP API keys ───────────────────────────────────────────────
# Without these, only NVD + EPSS + CISA KEV are queried (free, no key needed).
# cve-mcp-server docs: https://github.com/mukul975/cve-mcp-server
NVD_API_KEY=
GITHUB_TOKEN=
SHODAN_KEY=
VIRUSTOTAL_KEY=
GREYNOISE_API_KEY=
ABUSEIPDB_KEY=
URLSCAN_KEY=
CIRCL_PDNS_USER=
CIRCL_PDNS_PASS=

# ── Optional: Skills library ──────────────────────────────────────────────────
# Path where skills library is mounted (default: /opt/skills-library).
# After 'docker compose up casky-skills', the 754-skill mukul975 library
# is available at this path for plan generation and execution.
SKILLS_LIBRARY_PATH=/opt/skills-library

# ── Optional: Lab profile & target selection ────────────────────────────────
# Choose ONE target profile:
#   docker compose --profile lab-dvwa up -d       # DVWA (requires MySQL)
#   docker compose --profile lab-juice-shop up -d # OWASP Juice Shop (self-contained)
#   docker compose --profile lab-custom up -d     # Custom target (set TARGET_IMAGE below)
#
# Defaults: lab-dvwa profile, web-app skill
SKILL_IMAGE=ghcr.io/casky-ai/skills/web-app:latest
SKILL_LAB_NAME=skill-lab

# For lab-custom profile, specify your target container image
TARGET_IMAGE=ghcr.io/casky-ai/targets/dvwa:latest

# ── Database passwords ───────────────────────────────────────────────────────
# Used only with lab-dvwa profile (DVWA + MySQL)
DB_ROOT_PASSWORD=root
DB_PASSWORD=dvwa
