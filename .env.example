# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Casky platform sync ────────────────────────────────────────────
# CASKY_API_KEY: generate at app.casky.ai/profile → Runner Token.
# When set, 'casky harness' fetches investigation plans from your dashboard and
# reports findings back. Leave empty for local mode (findings → /var/casky/reports/).
CASKY_API_KEY=
CASKY_APP_URL=https://app.casky.ai
CASKY_LOCAL_PORT=8765

# Legacy single-run vars — still work for manual: casky run <skill>
CASKY_RUN_ID=
CASKY_TOKEN=

# ── Optional: Gemini CLI ──────────────────────────────────────────────────────
GOOGLE_API_KEY=

# ── Optional: CVE MCP API keys ───────────────────────────────────────────────
# Without these, only NVD + EPSS + CISA KEV are queried (free, no key needed).
# cve-mcp-server docs: https://github.com/mukul975/cve-mcp-server
NVD_API_KEY=
GITHUB_TOKEN=
SHODAN_KEY=
VIRUSTOTAL_KEY=
GREYNOISE_API_KEY=
ABUSEIPDB_KEY=
URLSCAN_KEY=
CIRCL_PDNS_USER=
CIRCL_PDNS_PASS=

# ── Optional: Lab profile overrides ──────────────────────────────────────────
# Used with: docker compose --profile lab up
# Defaults are web-app + dvwa. Change to match your exercise.
SKILL_IMAGE=ghcr.io/casky-ai/skills/web-app:latest
TARGET_IMAGE=ghcr.io/casky-ai/targets/dvwa:latest
SKILL_LAB_NAME=skill-lab

# ── Optional: database password ──────────────────────────────────────────────
DB_PASSWORD=casky
