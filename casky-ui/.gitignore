# Next.js build output — regenerated by `npm run build`/`npm run dev`,
# never committed (accidentally committed once, see git history — this
# file exists specifically to stop that from happening again).
.next/
out/

# Dependencies (root .gitignore already covers node_modules/ repo-wide,
# this is belt-and-suspenders for anyone running lint/gitignore tools
# scoped to just this directory)
node_modules/

# Local env overrides — CASKY_UI_ADMIN_PASSWORD etc. belong in the
# top-level .env, not here, but never commit a local override if one
# exists
.env*.local

# Editor/OS cruft
.DS_Store
*.log

# TypeScript incremental build cache — machine-generated, matches the
# convention already established for apps/teams/tsconfig.tsbuildinfo in
# the sibling claude-skills-security repo (left uncommitted there too)
tsconfig.tsbuildinfo
